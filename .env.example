# ===== 次どこ行く？ こうきのやること =====
# このファイルを .env.local にコピーして値を入れる（.env.local は git に入りません）
#   cp .env.example .env.local

# 運用管理シートのID（URLの /d/ と /edit の間）
SPREADSHEET_ID=1TqcoHaZjGDk1VMWm5O0uQKHCFJte1Q5oE_Gj6tjF_7U

# サービスアカウントのメールアドレス（JSON鍵の client_email）
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@your-project.iam.gserviceaccount.com

# サービスアカウントの秘密鍵（JSON鍵の private_key）。改行は \n のまま、全体を " で囲む
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# アプリを開くときのパスコード（推測されにくいものに。8文字以上推奨）
APP_PASSCODE=change-me

# ログイン状態（Cookie）の署名用。長いランダム文字列にする
#   作り方: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# 1 にすると Google につながずにサンプルデータで画面を試せる（書き込みはメモリ上だけ）
SHEETS_MOCK=0

# ===== 通知（プッシュ通知） =====
# アプリの「通知」欄の「通知の鍵を作る」ボタンで作れる（または npx web-push generate-vapid-keys）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知の差出人（メールアドレス）
VAPID_SUBJECT=mailto:info.tsugidoko@gmail.com
# Vercel の定期実行（毎日12時台・20時台）が通知を送るときの合言葉。長いランダム文字列
CRON_SECRET=
